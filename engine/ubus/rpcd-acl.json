{
    "unauthenticated": {
        "description": "cheburnet web wizard — первичная установка (LAN-only). Мутации защищены install-токеном.",
        "read": {
            "ubus": {
                "cheburnet": [
                    "preflight",
                    "status",
                    "check_lan_conflict",
                    "install_progress"
                ]
            }
        },
        "write": {
            "ubus": {
                "cheburnet": [
                    "apply_lan_ip",
                    "install",
                    "install_cancel"
                ]
            }
        }
    },
    "cheburnet-admin": {
        "description": "cheburnet — пост-установочное управление (выдаётся авторизованной сессии).",
        "read": {
            "ubus": {
                "cheburnet": [
                    "preflight",
                    "status",
                    "check_lan_conflict",
                    "install_progress",
                    "get_domains",
                    "list_profiles",
                    "diagnostics"
                ]
            }
        },
        "write": {
            "ubus": {
                "cheburnet": [
                    "apply_lan_ip",
                    "install",
                    "install_cancel",
                    "set_mode",
                    "pause_protection",
                    "resume_protection",
                    "update_list",
                    "set_domains",
                    "service_restart",
                    "set_dns_provider",
                    "switch_to_awg",
                    "replace_awg_conf",
                    "add_profile",
                    "rename_profile",
                    "update_profile_conf",
                    "delete_profile",
                    "order_profiles",
                    "activate_profile",
                    "set_failover",
                    "install_token",
                    "factory_reset"
                ]
            }
        }
    }
}
